<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="600.0"
            prefWidth="400.0"
            xmlns="http://javafx.com/javafx/23"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="smcproject.Notification.NotificationPageController">

    <children>

        <ListView fx:id="notificationList"
                  prefHeight="500.0"
                  prefWidth="350.0"
                  layoutX="20.0"
                  layoutY="20.0"/>

        <Button text="Clear All"
                layoutX="150.0"
                layoutY="540.0"
                prefHeight="35.0"
                prefWidth="100.0"
                onAction="#clearNotifications"/>

    </children>

</AnchorPane>